# QLever UI Configuration
# Copy this file to .env and update with your actual values

# Django Configuration
QLEVERUI_DEBUG=True
#QLEVERUI_SECRET_KEY=your-secret-key-here
QLEVERUI_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal
QLEVERUI_CSRF_TRUSTED_ORIGINS=http://localhost:8178,http://127.0.0.1:8178,http://host.docker.internal:8178
#QLEVERUI_DATABASE_URL=sqlite:////absolute/path/to/db/qleverui.sqlite3

# Keycloak JWT Configuration for frontend authentication
# Replace with your actual Keycloak server details
KEYCLOAK_JWKS_URL=http://localhost:8085/realms/your-realm/protocol/openid-connect/certs
KEYCLOAK_ISSUER=http://localhost:8085/realms/your-realm
KEYCLOAK_AUDIENCE=qlever-ui

# Example for Docker setup:
# KEYCLOAK_JWKS_URL=http://host.docker.internal:8085/realms/cardiffportal/protocol/openid-connect/certs
# KEYCLOAK_ISSUER=http://host.docker.internal:8085/realms/cardiffportal
# KEYCLOAK_AUDIENCE=qlever-ui
